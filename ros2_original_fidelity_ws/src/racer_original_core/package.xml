<?xml version="1.0"?>
<package format="3">
  <name>racer_original_core</name>
  <version>0.1.0</version>
  <description>Algorithm-faithful ROS 2 build of the original RACER C++ sources.</description>
  <maintainer email="jiazheng@example.com">jiazheng</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>racer_fidelity_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
