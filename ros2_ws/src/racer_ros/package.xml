<?xml version="1.0"?>
<package format="3">
  <name>racer_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 Humble rclpy nodes for RACER exploration and trajectory execution.</description>
  <maintainer email="kong-huihui@users.noreply.github.com">Kong-huihui</maintainer>
  <license>LicenseRef-RACER-Upstream</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>racer_core</exec_depend>
  <exec_depend>racer_interfaces</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
