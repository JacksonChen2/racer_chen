<?xml version="1.0"?>
<package format="3">
  <name>racer_3d_sionna_comm</name>
  <version>0.1.0</version>
  <description>Communication-aware C++ RACER for ROS 2, Isaac Sim, and Sionna RT.</description>
  <maintainer email="maintainer@example.com">RACER 3D Maintainer</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>eigen3_cmake_module</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>racer_3d_interfaces</depend>
  <depend>rclcpp</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>libjsoncpp-dev</depend>
  <depend>zlib</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
