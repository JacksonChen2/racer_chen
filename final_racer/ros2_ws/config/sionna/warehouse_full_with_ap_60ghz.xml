<?xml version='1.0' encoding='utf-8'?>
<scene version="2.1.0">
  <!--
    60 GHz variant of warehouse_full_with_industrial_ap/warehouse.xml.
    ITU-R P.2040 plywood is only tabulated from 1 to 40 GHz. Its coefficients in
    Sionna are frequency-independent (epsilon_r=2.71, sigma=0.33 S/m), so this
    scene makes that extrapolation explicit as a constant custom material.
  -->
  <bsdf type="itu-radio-material" id="concrete">
    <string name="type" value="concrete" />
    <float name="thickness" value="0.1" />
  </bsdf>
  <bsdf type="itu-radio-material" id="metal">
    <string name="type" value="metal" />
    <float name="thickness" value="0.1" />
  </bsdf>
  <bsdf type="itu-radio-material" id="wood">
    <string name="type" value="wood" />
    <float name="thickness" value="0.1" />
  </bsdf>
  <bsdf type="itu-radio-material" id="chipboard">
    <string name="type" value="chipboard" />
    <float name="thickness" value="0.1" />
  </bsdf>
  <bsdf type="itu-radio-material" id="ceiling_board">
    <string name="type" value="ceiling_board" />
    <float name="thickness" value="0.1" />
  </bsdf>
  <bsdf type="radio-material" id="plywood_60ghz_extrapolated">
    <float name="relative_permittivity" value="2.71" />
    <float name="conductivity" value="0.33" />
    <float name="thickness" value="0.1" />
  </bsdf>
  <shape type="ply" id="mesh-warehouse-concrete" name="mesh-warehouse-concrete">
    <string name="filename" value="../../../warehouse_scenes/sionna/warehouse_full_with_industrial_ap/meshes/warehouse_concrete.ply" />
    <boolean name="face_normals" value="true" />
    <ref id="concrete" name="bsdf" />
  </shape>
  <shape type="ply" id="mesh-warehouse-metal" name="mesh-warehouse-metal">
    <string name="filename" value="../../../warehouse_scenes/sionna/warehouse_full_with_industrial_ap/meshes/warehouse_metal.ply" />
    <boolean name="face_normals" value="true" />
    <ref id="metal" name="bsdf" />
  </shape>
  <shape type="ply" id="mesh-warehouse-wood" name="mesh-warehouse-wood">
    <string name="filename" value="../../../warehouse_scenes/sionna/warehouse_full_with_industrial_ap/meshes/warehouse_wood.ply" />
    <boolean name="face_normals" value="true" />
    <ref id="wood" name="bsdf" />
  </shape>
  <shape type="ply" id="mesh-warehouse-chipboard" name="mesh-warehouse-chipboard">
    <string name="filename" value="../../../warehouse_scenes/sionna/warehouse_full_with_industrial_ap/meshes/warehouse_chipboard.ply" />
    <boolean name="face_normals" value="true" />
    <ref id="chipboard" name="bsdf" />
  </shape>
  <shape type="ply" id="mesh-warehouse-ceiling_board" name="mesh-warehouse-ceiling_board">
    <string name="filename" value="../../../warehouse_scenes/sionna/warehouse_full_with_industrial_ap/meshes/warehouse_ceiling_board.ply" />
    <boolean name="face_normals" value="true" />
    <ref id="ceiling_board" name="bsdf" />
  </shape>
  <shape type="ply" id="mesh-warehouse-plywood" name="mesh-warehouse-plywood">
    <string name="filename" value="../../../warehouse_scenes/sionna/warehouse_full_with_industrial_ap/meshes/warehouse_plywood.ply" />
    <boolean name="face_normals" value="true" />
    <ref id="plywood_60ghz_extrapolated" name="bsdf" />
  </shape>
</scene>
