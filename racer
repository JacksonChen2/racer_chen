#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CPP_WS="${ROOT_DIR}/ros2_3d_C_ws"
PY_WS="${ROOT_DIR}/ros2_3d_py_ws"
COMM_WS="${ROOT_DIR}/ros2_3d_sionna_ws"
ROS1_WS="${ROOT_DIR}/original_racer_ros1_ws"
RESULTS_DIR="${ROOT_DIR}/results"

usage() {
  cat <<'EOF'
RACER warehouse_loaded 可移植运行入口

用法：
  ./racer doctor
  ./racer setup  cpp|python|comm|all
  ./racer build  original|cpp|python|comm|all
  ./racer test   cpp|python|comm|all
  ./racer mock   cpp|python [--duration 秒] [--drones 数量]
  ./racer run    cpp|python|comm [选项]
  ./racer visualize cpp|python|comm [选项]
  ./racer run-original

运行选项：
  --duration 秒       仿真时长，默认 900
  --drones 数量       无人机数，默认 3
  --domain ID         ROS_DOMAIN_ID；默认按实现隔离
  --mode 模式         通信版：ideal/range_only/sionna/sionna_hybrid
  --result 文件       结果 JSON；相对路径按发布包根目录解析
  --headless           无窗口运行
  --visualize          打开 Isaac 窗口并显示地图、轨迹与规划路径

示例：
  ./racer visualize cpp --duration 120 --drones 3
  ./racer run python --duration 900
  ./racer visualize comm --mode sionna_hybrid --duration 120
EOF
}

find_isaac_root() {
  local candidate
  for candidate in \
    "${ISAAC_SIM_ROOT:-}" \
    "${ISAAC_SIM_DIR:-}" \
    "${HOME}/isaacsim" \
    "/opt/isaacsim"; do
    if [[ -n "${candidate}" && -x "${candidate}/python.sh" ]]; then
      realpath "${candidate}"
      return 0
    fi
  done
  return 1
}

set_isaac_environment() {
  local isaac_root
  if ! isaac_root="$(find_isaac_root)"; then
    printf '找不到 Isaac Sim。请设置 ISAAC_SIM_ROOT=/绝对路径/isaacsim\n' >&2
    exit 2
  fi
  export ISAAC_SIM_ROOT="${isaac_root}"
  export ISAAC_SIM_DIR="${isaac_root}"
}

require_humble() {
  if [[ ! -f /opt/ros/humble/setup.bash ]]; then
    printf '缺少 ROS 2 Humble：/opt/ros/humble/setup.bash\n' >&2
    exit 2
  fi
  if ! command -v colcon >/dev/null 2>&1; then
    printf '缺少 colcon，请先执行 ./install_dependencies.sh\n' >&2
    exit 2
  fi
}

build_one() {
  local target="$1"
  local ws
  require_humble
  case "${target}" in
    cpp) ws="${CPP_WS}" ;;
    python) ws="${PY_WS}" ;;
    comm) ws="${COMM_WS}" ;;
    *) printf '未知 ROS 2 构建目标：%s\n' "${target}" >&2; exit 2 ;;
  esac
  printf '构建 %s：%s\n' "${target}" "${ws}"
  (
    # ROS setup files are not nounset-clean on every Humble patch level.
    set +u
    source /opt/ros/humble/setup.bash
    set -u
    cd "${ws}"
    colcon build --symlink-install --event-handlers console_direct+
  )
}

ensure_built() {
  local target="$1"
  local marker
  case "${target}" in
    cpp) marker="${CPP_WS}/install/racer_3d_cpp" ;;
    python) marker="${PY_WS}/install/racer_3d_py" ;;
    comm) marker="${COMM_WS}/install/racer_3d_sionna_comm" ;;
  esac
  if [[ ! -d "${marker}" ]]; then
    printf '%s 尚未构建，开始首次构建。\n' "${target}"
    build_one "${target}"
  fi
}

doctor() {
  local failures=0
  local isaac_root=""
  printf 'RACER 发布包：%s\n' "${ROOT_DIR}"
  if [[ -r /etc/os-release ]]; then
    # shellcheck disable=SC1091
    source /etc/os-release
    printf '[信息] 系统：%s %s\n' "${ID:-unknown}" "${VERSION_ID:-unknown}"
    if [[ "${ID:-}" != ubuntu || "${VERSION_ID:-}" != 22.04 ]]; then
      printf '[警告] ROS 2/Isaac 主流程的验证平台是 Ubuntu 22.04。\n'
    fi
  fi
  if [[ -f /opt/ros/humble/setup.bash ]]; then
    printf '[通过] ROS 2 Humble\n'
  else
    printf '[缺失] ROS 2 Humble\n'
    failures=$((failures + 1))
  fi
  if command -v colcon >/dev/null 2>&1; then
    printf '[通过] colcon：%s\n' "$(command -v colcon)"
  else
    printf '[缺失] colcon\n'
    failures=$((failures + 1))
  fi
  if command -v rosdep >/dev/null 2>&1; then
    printf '[通过] rosdep：%s\n' "$(command -v rosdep)"
  else
    printf '[缺失] rosdep\n'
    failures=$((failures + 1))
  fi
  if isaac_root="$(find_isaac_root)"; then
    printf '[通过] Isaac Sim：%s\n' "${isaac_root}"
    if [[ -d "${isaac_root}/exts/isaacsim.ros2.bridge/humble" ]]; then
      printf '[通过] Isaac ROS 2 Humble bridge\n'
    else
      printf '[缺失] Isaac ROS 2 Humble bridge\n'
      failures=$((failures + 1))
    fi
  else
    printf '[缺失] Isaac Sim；设置 ISAAC_SIM_ROOT\n'
    failures=$((failures + 1))
  fi
  if command -v nvidia-smi >/dev/null 2>&1; then
    printf '[通过] GPU：%s\n' "$(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader | head -1)"
  else
    printf '[警告] nvidia-smi 不可用，Isaac RTX 可视化可能无法运行。\n'
  fi
  local required
  for required in \
    "${ROOT_DIR}/warehouse_loaded.usd" \
    "${PY_WS}/warehouse.usd" \
    "${ROOT_DIR}/isaac_assets/racer_so3_quadrotor/usd/racer_so3_quadrotor_flattened.usd" \
    "${COMM_WS}/src/racer_3d_sionna_comm/assets/warehouse_loaded_sionna/hybrid_radio_cache.npz"; do
    if [[ -f "${required}" ]]; then
      printf '[通过] 文件：%s\n' "${required#${ROOT_DIR}/}"
    else
      printf '[缺失] 文件：%s\n' "${required#${ROOT_DIR}/}"
      failures=$((failures + 1))
    fi
  done
  if [[ -d "${COMM_WS}/.sionna_runtime/sionna" ]]; then
    printf '[通过] Sionna RT 本地运行环境\n'
  else
    printf '[待安装] Sionna RT；通信版首次运行前执行 ./racer setup comm\n'
  fi
  if (( failures > 0 )); then
    printf '检查完成：%d 项必需条件未满足。\n' "${failures}" >&2
    return 1
  fi
  printf '检查完成：ROS 2 + Isaac 主流程必需条件已满足。\n'
}

setup_one() {
  local target="$1"
  local ws
  require_humble
  if ! command -v rosdep >/dev/null 2>&1; then
    printf '缺少 rosdep，请先执行 ./install_dependencies.sh\n' >&2
    exit 2
  fi
  case "${target}" in
    cpp) ws="${CPP_WS}" ;;
    python) ws="${PY_WS}" ;;
    comm) ws="${COMM_WS}" ;;
    *) printf '未知依赖目标：%s\n' "${target}" >&2; exit 2 ;;
  esac
  (
    set +u
    source /opt/ros/humble/setup.bash
    set -u
    rosdep install --from-paths "${ws}/src" --ignore-src -r -y
  )
  if [[ "${target}" == comm && ! -d "${COMM_WS}/.sionna_runtime/sionna" ]]; then
    "${COMM_WS}/setup_sionna_env.sh"
  fi
}

test_one() {
  local target="$1"
  local ws packages
  case "${target}" in
    cpp) ws="${CPP_WS}"; packages="racer_3d_cpp" ;;
    python) ws="${PY_WS}"; packages="racer_3d_py" ;;
    comm) ws="${COMM_WS}"; packages="racer_3d_interfaces racer_3d_sionna_comm" ;;
    *) printf '未知测试目标：%s\n' "${target}" >&2; exit 2 ;;
  esac
  ensure_built "${target}"
  (
    set +u
    source /opt/ros/humble/setup.bash
    source "${ws}/install/setup.bash"
    set -u
    cd "${ws}"
    # Word splitting is intentional: colcon expects multiple package names.
    # shellcheck disable=SC2086
    colcon test --packages-select ${packages} --event-handlers console_direct+
    colcon test-result --verbose
  )
}

build_original() {
  if [[ ! -f /opt/ros/noetic/setup.bash ]]; then
    printf '原始 RACER 需要 Ubuntu 20.04 + ROS Noetic；当前只保留完整基线源码。\n' >&2
    printf '详见 original_racer_ros1_ws/src/RACER/README.md。\n' >&2
    exit 2
  fi
  (
    set +u
    source /opt/ros/noetic/setup.bash
    set -u
    cd "${ROS1_WS}"
    catkin_make
  )
}

run_original() {
  if [[ ! -f "${ROS1_WS}/devel/setup.bash" ]]; then
    build_original
  fi
  (
    set +u
    source /opt/ros/noetic/setup.bash
    source "${ROS1_WS}/devel/setup.bash"
    set -u
    roslaunch exploration_manager rviz.launch &
    local rviz_pid=$!
    trap 'kill "${rviz_pid}" 2>/dev/null || true' EXIT INT TERM
    roslaunch exploration_manager swarm_exploration.launch
  )
}

run_mock() {
  local target="$1" duration="$2" drones="$3" domain="$4"
  ensure_built "${target}"
  case "${target}" in
    cpp)
      RACER_3D_DURATION="${duration}" RACER_3D_DRONE_COUNT="${drones}" \
        ROS_DOMAIN_ID="${domain:-143}" \
        "${CPP_WS}/src/racer_3d_cpp/scripts/run_mock_test.sh"
      ;;
    python)
      RACER_3D_PY_DURATION="${duration}" RACER_3D_PY_DRONE_COUNT="${drones}" \
        ROS_DOMAIN_ID="${domain:-43}" \
        "${PY_WS}/src/racer_3d_py/scripts/run_mock_test.sh"
      ;;
    *) printf 'mock 仅支持 cpp 或 python。\n' >&2; exit 2 ;;
  esac
}

run_isaac() {
  local target="$1" duration="$2" drones="$3" domain="$4"
  local visualize="$5" mode="$6" result="$7"
  set_isaac_environment
  ensure_built "${target}"
  mkdir -p "${RESULTS_DIR}"
  if [[ -z "${result}" ]]; then
    result="${RESULTS_DIR}/${target}_warehouse_loaded_$(date +%Y%m%d_%H%M%S).json"
  elif [[ "${result}" != /* ]]; then
    result="${ROOT_DIR}/${result}"
  fi
  case "${target}" in
    cpp)
      RACER_3D_SCENARIO=warehouse_loaded \
      RACER_3D_SCENE_USD="${PY_WS}/warehouse_loaded.usd" \
      RACER_3D_DURATION="${duration}" \
      RACER_3D_DRONE_COUNT="${drones}" \
      RACER_3D_HEADLESS="$((1 - visualize))" \
      RACER_3D_VISUALIZE="${visualize}" \
      ROS_DOMAIN_ID="${domain:-172}" \
        "${CPP_WS}/src/racer_3d_cpp/scripts/run_isaac_test.sh" "${result}"
      ;;
    python)
      RACER_3D_PY_SCENARIO=warehouse_loaded \
      RACER_3D_PY_SCENE_USD="${PY_WS}/warehouse_loaded.usd" \
      RACER_3D_PY_DURATION="${duration}" \
      RACER_3D_PY_DRONE_COUNT="${drones}" \
      RACER_3D_PY_HEADLESS="$((1 - visualize))" \
      RACER_3D_PY_VISUALIZE="${visualize}" \
      ROS_DOMAIN_ID="${domain:-173}" \
        "${PY_WS}/src/racer_3d_py/scripts/run_isaac_test.sh" "${result}"
      ;;
    comm)
      if [[ ! -d "${COMM_WS}/.sionna_runtime/sionna" ]]; then
        printf '通信环境尚未安装；先执行 ./racer setup comm\n' >&2
        exit 2
      fi
      HEADLESS="$((1 - visualize))" \
      DURATION="${duration}" DRONE_COUNT="${drones}" \
      COMMUNICATION_MODE="${mode}" RESULT_FILE="${result}" \
      ROS_DOMAIN_ID="${domain:-174}" \
        "${COMM_WS}/run_warehouse_loaded_hybrid.sh"
      ;;
    *) printf 'Isaac 运行目标必须是 cpp、python 或 comm。\n' >&2; exit 2 ;;
  esac
}

command_name="${1:-help}"
if [[ $# -gt 0 ]]; then shift; fi

case "${command_name}" in
  help|-h|--help) usage ;;
  doctor) doctor ;;
  setup|build|test)
    target="${1:-all}"
    case "${target}" in
      all)
        if [[ "${command_name}" == setup ]]; then
          setup_one cpp; setup_one python; setup_one comm
        elif [[ "${command_name}" == build ]]; then
          build_one cpp; build_one python; build_one comm
        else
          test_one cpp; test_one python; test_one comm
        fi
        ;;
      original)
        if [[ "${command_name}" != build ]]; then
          printf 'original 仅支持 build 或 run-original。\n' >&2; exit 2
        fi
        build_original
        ;;
      cpp|python|comm) "${command_name}_one" "${target}" ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  run-original) run_original ;;
  run|visualize|mock)
    target="${1:-}"
    [[ -n "${target}" ]] || { usage >&2; exit 2; }
    shift
    duration=900
    drones=3
    domain=""
    mode=sionna_hybrid
    result=""
    visualize=0
    [[ "${command_name}" == visualize ]] && visualize=1
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --duration) duration="${2:?--duration 缺少值}"; shift 2 ;;
        --drones) drones="${2:?--drones 缺少值}"; shift 2 ;;
        --domain) domain="${2:?--domain 缺少值}"; shift 2 ;;
        --mode) mode="${2:?--mode 缺少值}"; shift 2 ;;
        --result) result="${2:?--result 缺少值}"; shift 2 ;;
        --visualize) visualize=1; shift ;;
        --headless) visualize=0; shift ;;
        *) printf '未知选项：%s\n' "$1" >&2; usage >&2; exit 2 ;;
      esac
    done
    [[ "${duration}" =~ ^[0-9]+([.][0-9]+)?$ ]] || { printf 'duration 必须为正数。\n' >&2; exit 2; }
    [[ "${drones}" =~ ^[1-9][0-9]*$ ]] || { printf 'drones 必须为正整数。\n' >&2; exit 2; }
    if [[ "${command_name}" == mock ]]; then
      run_mock "${target}" "${duration}" "${drones}" "${domain}"
    else
      run_isaac "${target}" "${duration}" "${drones}" "${domain}" \
        "${visualize}" "${mode}" "${result}"
    fi
    ;;
  *) printf '未知命令：%s\n' "${command_name}" >&2; usage >&2; exit 2 ;;
esac
