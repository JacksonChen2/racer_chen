<?xml version="1.0"?>
<package format="3">
  <name>c2_explorer_isaac</name>
  <version>0.1.0</version>
  <description>Isaac Sim sensor, control and visualization boundary for the source-faithful C2-Explorer ROS 2 port.</description>
  <maintainer email="jiazheng@example.com">jiazheng</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>c2_explorer_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
